# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
CHRIS_MODEL=
CHRIS_USE_MOCK_AGENTS=
# Database URL (optional in dev, defaults to sqlite:///./openbeavs.db)
# Production Cloud SQL: postgresql://<user>:<password>@<host>:5432/openbeavs_v2
DATABASE_URL=

# Microsoft SSO (OIDC / Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback
MICROSOFT_OAUTH_SCOPE=openid email profile

# Application Auth Security & Dev Bypass
SESSION_SECRET_KEY=
AUTH_BYPASS_DEV=true
