# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
CHRIS_MODEL=
# Database URL (optional in dev, defaults to sqlite:///./openbeavs.db)
# Production Cloud SQL: postgresql://<user>:<password>@<host>:5432/openbeavs_v2
DATABASE_URL=
# Agent registry (see docs/registry.md). None of these is a secret.
# Admin emails, comma-separated. Only these callers may approve or revoke agents.
REGISTRY_ADMIN_EMAILS=
# LOCAL DEVELOPMENT ONLY: "true" trusts X-User-Id / X-User-Email headers. Leave empty
# anywhere else; with it empty every registry route returns 501 until SSO exists.
# It is refused on Cloud Run or with a non-local DATABASE_URL.
REGISTRY_DEV_AUTH=
# LOCAL DEVELOPMENT ONLY: "true" allows plain http agent card URLs.
REGISTRY_ALLOW_HTTP=
# How new submissions are decided: "auto" (default, also when blank) makes an agent that
# passes the automated checks live as provisional; "manual" keeps every one pending.
REGISTRY_APPROVAL_MODE=

# Public backend base URL advertised by Chris's A2A card.
CHRIS_PUBLIC_URL=http://127.0.0.1:8010

# Microsoft Entra ID (OIDC) Authentication & Session Config
AUTH_SECRET_KEY=change-this-in-production-to-a-secure-32-byte-secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback
MICROSOFT_OAUTH_SCOPE=openid email profile
# Set to "true" to enable local mock dev logins (/auth/dev/login) without Azure AD
AUTH_BYPASS_DEV=true

# --- Registry A2A agent (expert selection; see docs/registry.md). Only the key is a secret.
# Public origin put in the registry's Agent Card (a bare origin; https on Cloud Run).
REGISTRY_PUBLIC_URL=http://127.0.0.1:8001
# Gemini model the registry uses to choose an expert. Required. Chris's CHRIS_MODEL is never used.
REGISTRY_MODEL=
# The registry's own Gemini API key (falls back to GEMINI_API_KEY). Never commit it.
REGISTRY_GEMINI_API_KEY=
# "google" or "dev" (no authentication, LOCAL ONLY; refused on Cloud Run). Blank: dev locally.
REGISTRY_A2A_AUTH=
REGISTRY_A2A_ALLOWED_CALLERS=
REGISTRY_A2A_AUDIENCE=
# Registry budget: simultaneous model calls per process, wait for a slot, one model request.
REGISTRY_MODEL_MAX_CONCURRENCY=
REGISTRY_MODEL_QUEUE_SECONDS=2
REGISTRY_MODEL_TIMEOUT_SECONDS=8

# --- Chris and Chat (see docs/chris.md and docs/registry.md#local-development-setup)
# Where Chris finds the registry (base A2A URL) and how long discovery + selection may take.
REGISTRY_A2A_URL=http://127.0.0.1:8001/a2a/registry
REGISTRY_A2A_TIMEOUT_SECONDS=14
# Where Chat finds Chris and how long it waits (must exceed the registry deadline).
CHRIS_A2A_URL=http://127.0.0.1:8010/chris/a2a/
CHRIS_A2A_TIMEOUT_SECONDS=35
# "false" (default): answer a no-match or registry failure with Gemini (needs GEMINI_API_KEY and CHRIS_MODEL).
# "true": diagnostic mode; report the registry decision without Gemini fallback.
CHRIS_SELECTION_ONLY=false
