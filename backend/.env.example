# Copy this file to backend/.env for local development. Never commit .env.

# Fill in your Gemini key privately. The registry and Chris share it by default.
GEMINI_API_KEY=
# Choose a Gemini model ID available to your key. Neither model has a code default.
REGISTRY_MODEL=
# Required only for Chris's direct Gemini fallback.
CHRIS_MODEL=

# Local database shared by the backend and registry. Start both from backend/.
DATABASE_URL=sqlite:///./openbeavs.db

# Local service addresses used by start-dev.py. The launcher sets these too.
REGISTRY_PUBLIC_URL=http://127.0.0.1:8001
REGISTRY_A2A_URL=http://127.0.0.1:8001/a2a/registry
CHRIS_PUBLIC_URL=http://127.0.0.1:8000
CHRIS_A2A_URL=http://127.0.0.1:8000/chris/a2a/

# Registry selection service (docs/registry.md).
# dev allows unauthenticated A2A calls in local development only.
# For deployed services, use google and configure the allowed callers.
REGISTRY_A2A_AUTH=dev
REGISTRY_A2A_ALLOWED_CALLERS=
# Blank uses REGISTRY_PUBLIC_URL as the audience in google mode.
REGISTRY_A2A_AUDIENCE=
# Optional separate key. Blank uses GEMINI_API_KEY.
REGISTRY_GEMINI_API_KEY=
REGISTRY_MODEL_MAX_CONCURRENCY=8
REGISTRY_MODEL_QUEUE_SECONDS=2
REGISTRY_MODEL_TIMEOUT_SECONDS=8
REGISTRY_A2A_TIMEOUT_SECONDS=14

# Registry management API. Enable dev auth only to test management locally.
# It trusts X-User-Id and X-User-Email headers and is refused in deployment.
REGISTRY_DEV_AUTH=false
# Comma-separated admin emails for approval and revocation.
REGISTRY_ADMIN_EMAILS=
# Keep HTTPS required for registered agent cards.
REGISTRY_ALLOW_HTTP=false
# auto makes submissions that pass checks provisional. manual keeps them pending.
REGISTRY_APPROVAL_MODE=auto

# Chris dispatch and Chat (docs/chris.md).
CHRIS_EXPERT_A2A_VERSION=0.3
CHRIS_EXPERT_TIMEOUT_SECONDS=30
# Set true for verbose expert-call logs in the standalone Chris console.
CHRIS_EXPERT_DEBUG=false
# Allow time for registry selection plus expert dispatch or Gemini fallback.
CHRIS_A2A_TIMEOUT_SECONDS=50
