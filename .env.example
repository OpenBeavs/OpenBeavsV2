# Copy this file to .env, beside it at the repository root, for local development.
# Every service reads that one file. Never commit .env.

# Fill in your Gemini key privately. Chris reads only this key, so it is required even
# when REGISTRY_GEMINI_API_KEY is set; the registry uses it when that one is blank.
GEMINI_API_KEY=
# Choose a Gemini model ID available to your key. Neither model has a code default.
# Read by the Agent Registry (agent-registry/).
REGISTRY_MODEL=
# Read by Chris (chat-system/conversation-agent/); required only for his direct Gemini
# fallback.
CHRIS_MODEL=

# Each service's own database, relative to the folder it starts in: the registry
# uses agent-registry/openbeavs.db, and Application Services uses
# chat-system/application-services/openbeavs.db. Chris has none. The launchers give
# every service this one value, so leave it as it is; README.md, "Databases", gives
# each owner an address of its own.
DATABASE_URL=sqlite:///./openbeavs.db

# Local service addresses used by start-dev.py. The launcher sets these too.
REGISTRY_PUBLIC_URL=http://127.0.0.1:8001
REGISTRY_A2A_URL=http://127.0.0.1:8001/a2a/registry
CHRIS_PUBLIC_URL=http://127.0.0.1:8000
CHRIS_A2A_URL=http://127.0.0.1:8000/chris/a2a/

# Application Services (chat-system/application-services/): Microsoft Entra ID (OIDC)
# Authentication & Session Config
AUTH_SECRET_KEY=change-this-in-production-to-a-secure-32-byte-secret
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CLIENT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8080/oauth/microsoft/callback
MICROSOFT_OAUTH_SCOPE=openid email profile
# The Web UI's origin, to which the sign-in page hands the session (window.postMessage).
# Blank uses MICROSOFT_REDIRECT_URI's origin, here http://localhost:8080, where the
# launcher serves the Web UI.
FRONTEND_ORIGIN=
# Set to "true" to enable local mock dev logins (/auth/dev/login) without Azure AD
AUTH_BYPASS_DEV=true

# Agent Registry selection service (agent-registry/README.md).
# dev allows unauthenticated A2A calls in local development only.
# For deployed services, use google and configure the allowed callers.
REGISTRY_A2A_AUTH=dev
REGISTRY_A2A_ALLOWED_CALLERS=
# Blank uses REGISTRY_PUBLIC_URL as the audience in google mode.
REGISTRY_A2A_AUDIENCE=
# Optional separate key. Blank uses GEMINI_API_KEY.
REGISTRY_GEMINI_API_KEY=
REGISTRY_MODEL_MAX_CONCURRENCY=8
REGISTRY_MODEL_QUEUE_SECONDS=2
REGISTRY_MODEL_TIMEOUT_SECONDS=8

# Agent Registry management API. Enable dev auth only to test management locally.
# It trusts X-User-Id and X-User-Email headers and is refused in deployment.
REGISTRY_DEV_AUTH=false
# Comma-separated admin emails for approval and revocation.
REGISTRY_ADMIN_EMAILS=
# Keep HTTPS required for registered agent cards.
REGISTRY_ALLOW_HTTP=false
# auto makes submissions that pass checks provisional. manual keeps them pending.
REGISTRY_APPROVAL_MODE=auto

# Chris dispatch and Chat (chat-system/conversation-agent/README.md).
CHRIS_EXPERT_A2A_VERSION=0.3
CHRIS_EXPERT_TIMEOUT_SECONDS=30
# Set true for verbose expert-call logs in the standalone Chris console.
CHRIS_EXPERT_DEBUG=false
# Allow time for registry selection plus expert dispatch or Gemini fallback.
CHRIS_A2A_TIMEOUT_SECONDS=50
# How long Chris waits for the registry's selection.
REGISTRY_A2A_TIMEOUT_SECONDS=14
